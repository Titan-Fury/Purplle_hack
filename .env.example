# ---- Database (PostgreSQL) ----
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex_secret
POSTGRES_DB=store_intelligence
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async DSN. For local (no docker) use a sqlite fallback:
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://apex:apex_secret@db:5432/store_intelligence

# ---- API ----
APP_ENV=production
LOG_LEVEL=INFO
STORE_LAYOUT_PATH=data/store_layout.json
POS_CSV_PATH=data/pos_transactions.csv

# Business rule windows (seconds)
SESSION_WINDOW_S=3600
POS_CORRELATION_WINDOW_S=300
STALE_FEED_THRESHOLD_S=600
DEAD_ZONE_THRESHOLD_S=1800
DWELL_EMIT_INTERVAL_S=30
MIN_SESSIONS_FOR_CONFIDENCE=20
CONVERSION_DROP_LOOKBACK_DAYS=7
