# ---- Database (PostgreSQL) ----
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex_secret
POSTGRES_DB=store_intelligence
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async DSN. For local (no docker) use a sqlite fallback:
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://apex:apex_secret@db:5432/store_intelligence

# ---- API ----
APP_ENV=production
LOG_LEVEL=INFO
STORE_LAYOUT_PATH=data/store_layout.json
POS_CSV_PATH=data/pos_transactions.csv

# Business rule windows (seconds)
SESSION_WINDOW_S=3600
POS_CORRELATION_WINDOW_S=300
STALE_FEED_THRESHOLD_S=600
DEAD_ZONE_THRESHOLD_S=1800
DWELL_EMIT_INTERVAL_S=30
MIN_SESSIONS_FOR_CONFIDENCE=20
CONVERSION_DROP_LOOKBACK_DAYS=7

# ---- Optional VLM for camera auto-classification (off by default) ----
# Used ONLY by the detection pipeline's `--resolve-mode auto`; the API/dashboard never
# call a VLM. Multi-provider fallback chain, tried in this order (all free tiers):
#   1) Google Gemini (primary)   2) Groq   3) OpenRouter   4) local Ollama (no key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
# Local open-source via Ollama (no key needed):
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=llama3.2-vision      # or: llava, moondream, qwen2.5vl
